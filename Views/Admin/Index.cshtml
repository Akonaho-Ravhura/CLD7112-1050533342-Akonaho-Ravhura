@{
    ViewData["Title"] = "Seed Mock Data";
}

<h1>Seed Mock Data</h1>
<p class="text-muted">Development only. Clears the Customer and Product tables and repopulates them from public mock-data APIs (randomuser.me and dummyjson.com).</p>

@if (TempData["SeedResult"] != null)
{
    <div class="alert alert-success">@TempData["SeedResult"]</div>
}

<form asp-action="Seed" method="post" class="row g-3 align-items-end">
    <div class="col-auto">
        <label for="customers" class="form-label">Customers</label>
        <input type="number" id="customers" name="customers" value="20" min="1" max="100" class="form-control" />
    </div>
    <div class="col-auto">
        <label for="products" class="form-label">Products</label>
        <input type="number" id="products" name="products" value="20" min="1" max="100" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Seed Data</button>
    </div>
</form>
