@model IEnumerable<ABC_Inc_Project_CLD7112.Models.CustomerProfile>

<h1>Customers</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Customer</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Phone Number</th>
            <th>Shipping Address</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.FirstName</td>
                <td>@customer.LastName</td>
                <td>@customer.Email</td>
                <td>@customer.PhoneNumber</td>
                <td>@customer.ShippingAddress</td>
                <td>
                    <a asp-action="Edit" asp-route-rowKey="@customer.RowKey" class="btn btn-sm btn-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-rowKey="@customer.RowKey" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>