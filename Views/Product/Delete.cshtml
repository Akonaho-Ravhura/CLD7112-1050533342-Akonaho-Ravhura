@model ABC_Inc_Project_CLD7112.Models.Product
@{
    ViewData["Title"] = "Delete Product";
}

<h1>Delete Product</h1>

<p>Are you sure you want to delete this product?</p>

@if (!string.IsNullOrEmpty(Model.ImageUrl))
{
    <img src="@Model.ImageUrl" style="max-height:150px;" class="mb-3 d-block" />
}

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.ProductName</dd>
    <dt class="col-sm-2">Category</dt>
    <dd class="col-sm-10">@Model.ProductCategory</dd>
    <dt class="col-sm-2">Price</dt>
    <dd class="col-sm-10">@Model.StockPrice.ToString("0.00")</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="RowKey" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
