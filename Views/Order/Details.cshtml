@model OrderDetailsViewModel
@{
    ViewData["Title"] = "Order Details";
}

<h1>Order Details</h1>

<dl class="row">
    <dt class="col-sm-2">Customer</dt>
    <dd class="col-sm-10">@Model.Order.CustomerName</dd>
    <dt class="col-sm-2">Order Date</dt>
    <dd class="col-sm-10">@Model.Order.OrderDate.ToString("g")</dd>
    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@Model.Order.Status</dd>
    <dt class="col-sm-2">Total</dt>
    <dd class="col-sm-10">@Model.Order.TotalAmount.ToString("0.00")</dd>
</dl>

<h5>Items</h5>
<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Line Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("0.00")</td>
                <td>@item.LineTotal.ToString("0.00")</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Edit" asp-route-rowKey="@Model.Order.RowKey" class="btn btn-secondary">Edit Status</a>
<a asp-action="Index" class="btn btn-secondary">Back to Orders</a>
