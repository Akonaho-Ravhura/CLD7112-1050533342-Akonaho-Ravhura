@model OrderCreateViewModel
@{
    ViewData["Title"] = "New Order";
}

<h1>New Order</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label for="CustomerRowKey" class="form-label">Customer</label>
        <select name="CustomerRowKey" id="CustomerRowKey" class="form-select">
            <option value="">-- Select a customer --</option>
            @foreach (var customer in Model.Customers)
            {
                <option value="@customer.RowKey" selected="@(customer.RowKey == Model.CustomerRowKey)">@customer.DisplayName</option>
            }
        </select>
    </div>

    <h5>Products</h5>
    @if (Model.Lines.Count == 0)
    {
        <p class="text-muted">No products available yet.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Unit Price</th>
                    <th>In Stock</th>
                    <th style="max-width:120px;">Quantity</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Lines.Count; i++)
                {
                    <tr>
                        <td>
                            @Model.Lines[i].ProductName
                            <input type="hidden" asp-for="Lines[i].ProductRowKey" />
                        </td>
                        <td>@Model.Lines[i].UnitPrice.ToString("0.00")</td>
                        <td>@Model.Lines[i].AvailableStock</td>
                        <td style="max-width:120px;">
                            <input asp-for="Lines[i].Quantity" class="form-control" type="number" min="0" max="@Model.Lines[i].AvailableStock" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <button type="submit" class="btn btn-primary">Place Order</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
