@model IEnumerable<ABC_Inc_Project_CLD7112.Models.Order>
@{
    ViewData["Title"] = "Orders";
}

<h1>Orders</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">New Order</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Customer</th>
            <th>Order Date</th>
            <th>Status</th>
            <th>Total</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.CustomerName</td>
                <td>@order.OrderDate.ToString("g")</td>
                <td>@order.Status</td>
                <td>@order.TotalAmount.ToString("0.00")</td>
                <td>
                    <a asp-action="Details" asp-route-rowKey="@order.RowKey" class="btn btn-sm btn-secondary">Details</a>
                    <a asp-action="Edit" asp-route-rowKey="@order.RowKey" class="btn btn-sm btn-secondary">Edit Status</a>
                    <a asp-action="Delete" asp-route-rowKey="@order.RowKey" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
