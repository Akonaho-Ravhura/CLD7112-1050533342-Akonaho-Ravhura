@model ABC_Inc_Project_CLD7112.Models.Order
@{
    ViewData["Title"] = "Delete Order";
}

<h1>Delete Order</h1>

<p>Are you sure you want to delete this order and all its items?</p>

<dl class="row">
    <dt class="col-sm-2">Customer</dt>
    <dd class="col-sm-10">@Model.CustomerName</dd>
    <dt class="col-sm-2">Order Date</dt>
    <dd class="col-sm-10">@Model.OrderDate.ToString("g")</dd>
    <dt class="col-sm-2">Total</dt>
    <dd class="col-sm-10">@Model.TotalAmount.ToString("0.00")</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="RowKey" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
